{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tienda-systec",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // Frontend React como SPA; todo lo que empiece con /api/ lo atiende el Worker
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Bucket R2 para las imágenes de productos (créalo con: npx wrangler r2 bucket create systec-images)
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "systec-images" }
  ],

  // Tu dominio (ya está en Cloudflare). Wrangler crea los registros DNS automáticamente.
  "routes": [
    { "pattern": "www.systecfl.site", "custom_domain": true },
    { "pattern": "systecfl.site", "custom_domain": true }
  ],

  // Variables NO secretas
  "vars": {
    "MAIL_FROM": "SYSTEC <no-reply@systecfl.site>",
    // Site key pública del widget de Turnstile "SYSTEC auth" (systecfl.site y www). En local se usa la de prueba de .dev.vars
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFgQEzgrh2W8VHJp",
    // Llave pública de Culqi (CulqiPanel → Desarrollo → API Keys). Cambiar a pk_live_ al pasar a producción
    "CULQI_PUBLIC_KEY": "pk_test_WEVuEVtlBL73hBZw"
  }
  // Secretos (NO van aquí): DATABASE_URL, JWT_SECRET, TURNSTILE_SECRET_KEY, RESEND_API_KEY, CULQI_SECRET_KEY
  //   npx wrangler secret put CULQI_SECRET_KEY        (llave privada sk_test_/sk_live_ de Culqi)
  //   npx wrangler secret put DATABASE_URL
  //   npx wrangler secret put JWT_SECRET
  //   npx wrangler secret put TURNSTILE_SECRET_KEY
  //   npx wrangler secret put RESEND_API_KEY   (para enviar el código de recuperación de contraseña)
}
